# Normalize line endings so the repo is consistent across OSes (silences the LF/CRLF churn).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary (no EOL/diff munging).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.gguf binary
*.safetensors binary
*.onnx binary
*.ckpt binary
*.zip binary

# Keep JSONL diffs line-based.
*.jsonl text eol=lf
