# Copy to .env and fill in. .env is git-ignored. Keep Discord and YouTube creds in SEPARATE scopes.
# In production, prefer SOPS+age over a plaintext .env (see docs/adr/ and RUNBOOK).

# --- Discord (control plane) ---
# Bot token from https://discord.com/developers/applications  (enable only the intents you need;
# do NOT enable Message Content unless a feature actually requires it).
DISCORD_BOT_TOKEN=changeme
DISCORD_GUILD_ID=000000000000000000
DISCORD_CONTROL_CHANNEL_ID=000000000000000000   # where "stack ready" + gates are posted

# --- Local model gateway (OpenAI-compatible) ---
# The agents talk to THIS, never directly to llama.cpp. Swapping backends = changing this URL.
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8080/v1
MODEL_GATEWAY_API_KEY=local-not-secret
PRIMARY_MODEL=qwen3-4b-instruct-2507     # dense, fully in VRAM, measured 93 tok/s (ADR-0011 benchmark)
# Fallback A/B: qwen3-8b-q4_k_m (slower, needs thinking disabled via chat_template_kwargs)
# After the RAM upgrade (TASK-008), consider the 30B MoE brain (ADR-0002), but note the
# DDR4 reality check first: expect ~12-15 tok/s, not 30.

# --- ComfyUI (SDXL, native Windows + ZLUDA) ---
COMFYUI_BASE_URL=http://127.0.0.1:8188

# --- NOT YET USED (planned features; safe to leave as-is) ---
# Preview link delivery: never needed - proxies fit Discord's cap, attached directly.
PREVIEW_PUBLIC_BASE_URL=https://your-tunnel.example.com
# YouTube API publishing: deferred - the owner uploads manually (metadata is auto-drafted).
YOUTUBE_CLIENT_SECRET_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# --- Paths ---
STATE_DIR=./state
DB_PATH=./atelier.db
MODELS_DIR=./models
